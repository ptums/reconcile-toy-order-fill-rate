# The store the worker talks to. Default: the local mock.
# To use the real Shopify Admin GraphQL API, set the store's Admin API URL and an access token.
STORE_GRAPHQL_URL=http://localhost:8001/graphql
STORE_TOKEN=mock-token
NATS_URL=nats://localhost:4222
DATABASE_URL=postgresql://reconciler:reconciler@localhost:5432/reconciler
AWS_ENDPOINT_URL=http://localhost:4566
DYNAMODB_ENDPOINT_URL=http://localhost:8000
AWS_REGION=us-east-1
