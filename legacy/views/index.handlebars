<div id="timer"></div>
<form id="uploadForm" action="/api/parse-csv" method="POST" enctype="multipart/form-data">
   <div>
      <label
         for="uploadCSV"
         class="form-label text-center d-block mx-auto"
         >
      Upload the CSV file here
      </label>
      <input
         class="form-control form-control-lg w-50 mx-auto text-center"
         id="uploadCSV"
         name="uploadCSV"
         type="file"
         type="file"
         accept="file/*"
         required
         >
   </div>
   <div>
      <button type="submit" id="sendBtn" class="btn btn-success btn-lg my-3 text-center d-block mx-auto">Send</button>
   </div>
</form>
