<!DOCTYPE html>
<html lang="en">
   <head>
      <meta charset="utf-8">
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0-beta3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-eOJMYsd53ii+scO/bJGFsiCZc+5NDVN2yr8+0RDqr0Ql0h+rP48ckxlpbzKgwra6" crossorigin="anonymous">
      <title>CSV Parser & Uploader</title>
      <style>
         body {
         margin: 0;
         padding:0;
         background: rgb(187,187,187);
         background: linear-gradient(180deg, rgba(186,186,186,1) 0%, rgba(221,221,221,1) 100%);
         height: 100%;
         background-repeat: no-repeat;
         background-attachment: fixed;
         }

         a {
            color: black;
         }

         ul {
            margin-left: -48px;
         }
      </style>
   </head>
   <body class="flex-column min-100-vh">
      <header>
         <div class="container my-4 text-center">
            <div class="row">
               <div class="col-sm-12">
                  <a href="/"><h1>Upload file and send to Shopify</h1></a>
               </div>
            </div>
         </div>
      </header>
      <main class="col-auto">
         <div class="container">
            <div class="row">
               <div class="col-sm-12 my-5">
                   {{{body}}}
                </div>
            </div>
         </div>
      </main>
      <script>
         document.getElementById('uploadForm').addEventListener('submit', (e) => {
            const btnElm = document.getElementById('sendBtn');
            btnElm.innerText = "Processing...";
            btnElm.disabled = "disabled";
         })
      </script>
   </body>
</html>